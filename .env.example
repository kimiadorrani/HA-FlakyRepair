# ------------------------------------------------------------------
# HA-FlakyRepair Environment Variables Template
# ------------------------------------------------------------------
# Copy this file to .env and fill in the values below to run the project locally.

# Groq API Key (Required to power the Qwen LangGraph Agent)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LangSmith Tracing (Highly recommended for LangGraph debugging visually)
# Get yours at: https://smith.langchain.com/ settings
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=ha-flaky-repair
LANGCHAIN_API_KEY=your_langchain_api_key_here

# GitHub Personal Access Token (Used to prevent rate-limiting when cloning datasets over HTTP)
# Get yours at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
